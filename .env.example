# Web3Forms access key — public by design (an alias for the destination
# email, not a secret), so it's safe to expose client-side. Bundled at build
# time, so it must be present when `vite build` runs: set this in the
# Cloudflare Workers build environment variables for production, and here in
# .env for local dev.
VITE_WEB3FORMS_ACCESS_KEY=

# Cloudflare Web Analytics beacon token — public, safe to expose client-side.
# Create a Web Analytics site for this domain in the Cloudflare dashboard to
# get the token; the analytics beacon is omitted entirely if left blank.
VITE_CF_BEACON_TOKEN=
