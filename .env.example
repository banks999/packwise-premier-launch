# Server-only Web3Forms access key. The contact form now submits via a
# TanStack Start server function, so this must stay unprefixed (no VITE_) —
# a VITE_ prefix would bundle it into client JS. Set the real value in
# production with: wrangler secret put WEB3FORMS_ACCESS_KEY
WEB3FORMS_ACCESS_KEY=

# Cloudflare Turnstile site key — public, safe to expose client-side.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key — server-only, verified in the contact
# server function before forwarding to Web3Forms. Set the real value in
# production with: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=
